FROM maven:3.6.3-jdk-8

ENV DEBIAN_FRONTEND=noninteractive

# Point apt to the archived Debian repos that still serve Buster packages
RUN set -eux; \
    sed -i 's|deb.debian.org/debian|archive.debian.org/debian|g' /etc/apt/sources.list; \
    sed -i 's|security.debian.org/debian-security|archive.debian.org/debian-security|g' /etc/apt/sources.list; \
    printf 'Acquire::Check-Valid-Until \"false\";\nAcquire::Check-Date \"false\";\n' > /etc/apt/apt.conf.d/99debian-archive.conf

# Install Liberica JDK 8 full (JavaFX) + xdg-utils for desktop integration
RUN set -eux; \
    apt-get update; \
    apt-get install -y wget gnupg2 ca-certificates; \
    printf '%s\n' \
