{
    "name": "ASTRO Dev",
    "build": {
      "dockerfile": "Dockerfile.dev",
      "context": ".."
    },
    "workspaceFolder": "/app",
    "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind",
    "customizations": {
      "vscode": {
        "extensions": [
          "ms-dotnettools.csharp"
        ]
      }
    },
    "forwardPorts": [8080],
    "postCreateCommand": "bash -lc \"dotnet --info\""
  }
